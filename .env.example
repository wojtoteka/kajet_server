# Wzór pliku .env. Skopiuj jako .env i uzupełnij.
#
# Prawdziwy .env NIE trafia do repozytorium (patrz .gitignore) - ma w środku
# hasła i klucze. Tu stoją same nazwy i wartości domyślne, żeby dało się
# postawić serwer od zera bez zgadywania.

# --- Baza danych ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=kajet

# --- Adres i port ---
NEXT_PUBLIC_BASE_URL=http://localhost:9081
PORT=9081

# Klucz do podpisywania ciasteczek sesji. Losowy, długi, własny dla serwera.
AUTH_SECRET=

# --- Logowanie przez Google (nieobowiązkowe) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Poczta ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kajet <kajet@wojtoteka.ovh>

# --- Pliki i limity ---
FILES_DIR=./data/files
APP_DIR=./data/app
MAX_FILE_BYTES=26214400
DEFAULT_QUOTA_BYTES=524288000
SERVER_QUOTA_BYTES=21474836480
TRASH_DAYS=30
INACTIVE_DAYS=365
INACTIVE_GRACE_DAYS=30

# --- Formularz kontaktowy ---
CONTACT_API_KEY=
CONTACT_EMAIL=kontakt@wojtoteka.ovh
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# --- Uruchamianie kodu ---
CODE_ENABLED=false
CODE_IMAGE=kajet-runner:1
CODE_TIMEOUT_SECONDS=10
CODE_RUNS_PER_MINUTE=12
CODE_MAX_CONCURRENT=3

# --- Asystent KajetAI ---
#
# Bez klucza asystenta nie ma na serwerze wcale: punkt końcowy odpowiada tak
# samo jak nieznany adres, a w panelu i w aplikacji nie ma po nim śladu.
#
# Klucz zakłada się w Google AI Studio. Nowe klucze zaczynają się od „AQ." -
# to klucze uwierzytelniające, przypięte do konta usługi, bez terminu
# ważności. Stare klucze „AIza" Gemini API odrzuca od września 2026.
#
# UWAGA na poziom darmowy: warunki Gemini API mówią wprost, że treść wysłaną
# na darmowym poziomie Google wykorzystuje do rozwoju swoich produktów i że
# mogą ją czytać ludzie. Tak też jest napisane w polityce prywatności
# (punkt 3.9) i na ekranie zgody. Po włączeniu rozliczania w Google trzeba
# poprawić TAMTE dwa miejsca - tutaj nic się nie zmienia.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING=low
AI_TIMEOUT_SECONDS=60
AI_MAX_CHARS=60000
AI_CALLS_PER_HOUR=20
AI_CALLS_PER_DAY=100
AI_HISTORY_TURNS=6
AI_HISTORY_HOURS=24
