{
  "name": "kajet-server",
  "version": "0.1.0",
  "private": true,
  "description": "Kajet server: accounts, notes in the cloud, sharing and code execution.",
  "scripts": {
    "dev": "next dev --port 9081",
    "build": "node scripts/prisma.mjs generate && next build",
    "start": "next start --port 9081 --hostname 127.0.0.1",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "node scripts/prisma.mjs db push",
    "db:diff": "node scripts/prisma.mjs migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
    "db:apply": "bash scripts/zastosuj-schemat.sh",
    "db:limity": "node scripts/limity-zero-znaczy-zero.mjs",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:studio": "node scripts/prisma.mjs studio",
    "ikony": "node scripts/pobierz-ikony.mjs",
    "sprawdz": "node scripts/sprawdz-serwer.mjs",
    "sprawdz:pliki": "node scripts/sprawdz-pliki.mjs",
    "sprawdz:ai": "tsx scripts/sprawdz-asystenta.ts",
    "konta": "tsx scripts/konta.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@google/genai": "^2.16.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.25",
    "nodemailer": "^8.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ]
}
