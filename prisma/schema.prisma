// Kajet database.
//
// The principle is the same as in the tablet app: the truth about a note's
// content lives in a single JSON document, exactly the same as the content.json
// file inside the note directory. The database stores that document plus what
// is not in it: who owns it, how much space it takes and who it is shared with.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- Accounts ---

enum AccountRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  /// Username shown when sharing. An admin may change it.
  login         String    @unique
  email         String    @unique
  emailVerified DateTime?
  /// Empty when the account is created through Google only.
  passwordHash  String?   @db.Text
  name          String?
  image         String?   @db.Text
  role          AccountRole @default(USER)

  /// A blocked account cannot sign in and does not accept synchronisation.
  blocked       Boolean   @default(false)
  blockReason   String?   @db.Text

  /// Whether the account may run code on the server. An admin revokes this for
  /// a single account when someone starts straining the machine.
  canRunCode    Boolean   @default(true)

  /// Czy konto może prosić asystenta o zmianę notatki. Odwrotnie niż przy
  /// uruchamianiu kodu domyślnie NIE: treść notatki jedzie wtedy do Google,
  /// więc dostęp nadaje administrator po jednym koncie naraz.
  canUseAi      Boolean   @default(false)
  /// Kiedy właściciel konta zgodził się na wysyłanie treści notatek do Google.
  /// Puste znaczy brak zgody, a wtedy asystent nie ruszy, choćby uprawnienie
  /// wyżej było nadane. Wycofanie zgody czyści to pole.
  aiConsentAt   DateTime?
  /// Ile wywołań asystenta na dobę wolno temu kontu. Zero bierze wartość
  /// domyślną z ustawień serwera - tak samo jak zero w limicie miejsca.
  aiDailyLimit  Int       @default(0)

  /// Miejsce na notatki w bajtach. ZERO ZNACZY ZERO: konto nie zapisze ani
  /// jednej notatki, dopóki miejsca mu się nie nada. Bez ograniczeń to -1.
  ///
  /// Zero było kiedyś „bez ograniczeń", a nowe konto dostawało 500 MB samo
  /// z siebie. Wychodziło z tego, że pomyłka w jedną stronę (wpisane zero)
  /// oddawała cały serwer, a w drugą - rozdawała pół giga bez pytania.
  /// Teraz miejsce nadaje się świadomie: przy kodzie zaproszenia albo
  /// z panelu.
  quotaBytes    BigInt    @default(0)
  /// How long the quota above applies. Empty means permanently.
  quotaUntil    DateTime?
  /// The quota we fall back to once a temporary quota expires.
  permanentQuotaBytes BigInt @default(0)
  /// Space used, recalculated on every save. We keep it so we do not have to
  /// sum up every note each time a quota is checked.
  usedBytes     BigInt    @default(0)

  /// Ustawienia pisania w panelu WWW. Autozapis zapisuje notatkę sam po
  /// pauzie w pisaniu; wyłączony zostawia zapis przyciskowi (i Ctrl+S).
  autoSave      Boolean   @default(true)
  /// Domyślny wygląd NOWEJ notatki tekstowej: krój, rozmiar (0 = domyślny)
  /// i wyrównanie. Te trzy jadą do pliku notatki, więc zna je też aplikacja.
  textFont      String    @default("body")
  textSize      Int       @default(0)
  textAlign     String    @default("left")
  /// Grube pismo w polu do pisania. Zostaje na stronie - plik notatki nie ma
  /// na to miejsca, a nie chcemy dopisywać do niego pól, których aplikacja
  /// na tablecie nie zna.
  textBold      Boolean   @default(false)

  createdAt     DateTime  @default(now())
  lastSignInAt  DateTime?

  /// Kiedy poszło ostrzeżenie, że konto jest nieużywane i zostanie skasowane.
  /// Puste znaczy, że nic jeszcze nie wysłaliśmy. Sprzątanie kasuje konto
  /// dopiero po upływie karencji liczonej od tego znacznika, a gdy ktoś w
  /// międzyczasie wróci, znacznik znika i wszystko zaczyna się od nowa.
  inactiveWarnedAt DateTime?

  /// Moment wylogowania ze wszystkich urządzeń. Sesje strony to podpisane
  /// ciasteczka (JWT), więc nie da się ich skasować w bazie - zamiast tego
  /// odrzucamy każdą wydaną wcześniej niż ten znacznik. Ustawia się przy
  /// „Wyloguj wszędzie" i przy zmianie hasła.
  sessionsRevokedAt DateTime?

  accounts      Account[]
  sessions      Session[]
  tokens        AppToken[]
  loginChallenges LoginChallenge[]
  folders       Folder[]
  notes         Note[]
  deletedNotes  DeletedNote[]
  issuedCodes   InviteCode[] @relation("IssuedCodes")
  usedCode      InviteCode?  @relation("UsedCode")
  shares        Share[]      @relation("SharedBy")
  releases      AppRelease[] @relation("UploadedReleases")
  aiTurns       AiTurn[]
  aiCalls       AiCall[]

  @@index([email])
  @@map("users")
}

/// External accounts, for example Google. Table required by Auth.js.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("oauth_accounts")
}

/// Browser session. Table required by Auth.js.
model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One-time token from an e-mail: address confirmation and password recovery.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("email_tokens")
}

/// Token for the mobile app. The app has no browser cookies, so every device
/// gets its own token and sends it in the Authorization header. A token can be
/// revoked separately for a single device.
model AppToken {
  id          String   @id @default(cuid())
  userId      String
  /// Hash of the token. We do not keep the token itself, just as we do not
  /// keep the password.
  tokenHash   String   @unique
  /// Device name shown in the list in account settings.
  device      String
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("app_tokens")
}

enum LoginChallengeStatus {
  PENDING
  APPROVED
  DENIED
  REDEEMED
}

/// One-time login for the mobile app. The app opens /signin/device with the
/// code; the user signs in (Google or password) in the browser and approves.
/// The app then polls until the challenge is redeemed for an AppToken.
model LoginChallenge {
  id           String               @id @default(cuid())
  /// Secret the app polls with. Stored hashed, same idea as AppToken.
  codeHash     String               @unique
  device       String
  status       LoginChallengeStatus @default(PENDING)
  userId       String?
  approvedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime             @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("login_challenges")
}

// --- Invite-only registration ---

/// Code from an administrator. Without one no account can be created.
/// The same code may be typed in by hand or received as a ready link.
model InviteCode {
  id           String    @id @default(cuid())
  code         String    @unique
  /// How many accounts may be created with this code. One is a plain invite.
  seats        Int       @default(1)
  usedSeats    Int       @default(0)
  /// Miejsce, jakie dostanie konto założone tym kodem. Zero znaczy zero,
  /// -1 znaczy bez ograniczeń, a puste pole (stare kody) - tyle, ile mówią
  /// ustawienia serwera.
  quotaBytes   BigInt?
  /// Czy konto założone tym kodem od razu może prosić asystenta o zmianę
  /// notatki. Samą zgodę na wysyłanie treści do Google i tak trzeba potem
  /// potwierdzić - kod nadaje uprawnienie, nie zgodę za człowieka.
  ///
  /// Pole zostaje dla kodów wystawionych, zanim pojawił się dzienny limit
  /// niżej. Nowe kody zapisują je razem z nim, żeby jedno nie mówiło czegoś
  /// innego niż drugie.
  grantsAi     Boolean   @default(false)
  /// Ile razy dziennie konto założone tym kodem może poprosić asystenta.
  /// ZERO ZNACZY „BEZ ASYSTENTA" - tak samo, jakby uprawnienia w ogóle nie
  /// nadano. Dostęp i jego wielkość to przy kodzie jedna decyzja, nie dwie.
  aiDailyLimit Int       @default(0)
  description  String?   @db.Text
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  issuedById   String
  issuedBy     User      @relation("IssuedCodes", fields: [issuedById], references: [id], onDelete: Cascade)

  /// Filled in for a single-seat code, so it is visible who used it.
  usedById     String?   @unique
  usedBy       User?     @relation("UsedCode", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([issuedById])
  @@map("invite_codes")
}

// --- Library ---

model Folder {
  id        String   @id @default(cuid())
  ownerId   String
  parentId  String?
  name      String
  colorId   String   @default("grafit")
  iconId    String   @default("folder")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  notes    Note[]

  @@index([ownerId, parentId])
  @@map("folders")
}

enum NoteKind {
  HANDWRITTEN
  TEXT
  MINDMAP
  CODE
}

model Note {
  id        String   @id @default(cuid())
  ownerId   String
  folderId  String?
  title     String
  kind      NoteKind
  favorite  Boolean  @default(false)
  tags      String   @default("") @db.Text

  /// The whole note content, that is the same as the content.json file
  /// on the tablet.
  content   String   @db.LongText
  /// Size of the content in bytes, computed on save. Counts towards the quota.
  sizeBytes Int      @default(0)

  /// Revision number. Goes up by one on every save and is used to tell whether
  /// the tablet has an older version than the server. Synchronisation is
  /// built on this.
  version   Int      @default(1)
  /// Hash of the content. When it matches there is nothing to transfer.
  hash      String   @default("") @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Note in the bin. It is deleted for real only when the bin is emptied.
  deletedAt DateTime?

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder      Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  shares      Share[]
  changes     LiveChange[]
  aiTurns     AiTurn[]

  @@index([ownerId, updatedAt])
  /// Bin: listing and counting a user's deleted notes.
  @@index([ownerId, deletedAt])
  @@index([folderId])
  @@map("notes")
}

/// Nagrobek po notatce skasowanej na zawsze.
///
/// Trwałe kasowanie usuwa wiersz notatki, więc przyrostowe pobieranie („co się
/// zmieniło od tej pory") nie ma jak powiedzieć urządzeniu, że notatka
/// zniknęła - wiersza po prostu nie ma i nie ma czego oddać. Zostaje po niej
/// ten wpis: sam identyfikator i data. Aplikacja pyta o nagrobki od swojego
/// znacznika czasu i kasuje u siebie dokładnie to, co serwer zgłosił, zamiast
/// zgadywać z brakującej pozycji na liście.
///
/// Wpisy nie mają terminu ważności. Jeden zajmuje kilkadziesiąt bajtów, a
/// każdy termin oznaczałby, że urządzenie milczące dłużej niż on nigdy nie
/// dowie się tą drogą o skasowaniu. Nagrobki znikają razem z kontem.
model DeletedNote {
  /// Identyfikator skasowanej notatki. Bez klucza obcego - wiersza notatki
  /// już nie ma, po to jest ten wpis.
  noteId    String   @id
  ownerId   String
  deletedAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// Odpytywanie po znaczniku czasu: „co skasowano od tej pory".
  @@index([ownerId, deletedAt])
  @@map("deleted_notes")
}

/// A photo or drawing belonging to a note. The file sits on disk and only the
/// description stays in the database, so the database does not swell up with
/// images.
model Attachment {
  id        String   @id @default(cuid())
  noteId    String
  /// Name used inside the note content, for example zdjecie-1.png.
  name      String
  mime      String
  sizeBytes Int
  /// Path relative to the files directory.
  path      String   @db.Text
  hash      String   @default("") @db.VarChar(64)
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, name])
  @@map("attachments")
}

// --- Sharing ---

enum Permission {
  READ
  EDIT
}

/// A shared note. Without an e-mail address it works as a link for anyone who
/// receives it. With an e-mail address it is personal and we send a notice.
model Share {
  id               String     @id @default(cuid())
  noteId           String
  token            String     @unique
  permission       Permission @default(READ)
  /// Empty means a link for anyone who has it.
  email            String?
  /// Whether someone without an account may use this.
  anonymousAllowed Boolean    @default(true)
  expiresAt        DateTime?
  createdAt        DateTime   @default(now())
  lastUsedAt       DateTime?

  sharedById String
  sharedBy   User @relation("SharedBy", fields: [sharedById], references: [id], onDelete: Cascade)
  note       Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([email])
  @@map("shares")
}

// --- Live editing ---

/// A single change sent by one of the people writing.
///
/// Clients fetch changes newer than the one they already have and apply them
/// locally. The row of changes is also a record of what happened, so a note can
/// be rebuilt from it should the full save be lost. Old entries are removed by
/// the cleanup that folds them into the whole.
model LiveChange {
  id         BigInt   @id @default(autoincrement())
  noteId     String
  /// Who sent it. Empty for someone without an account editing from a link.
  authorId   String?
  /// Name shown next to the other person's cursor.
  authorName String
  /// Description of the change in JSON. The shape depends on the note kind.
  operation  String   @db.LongText
  createdAt  DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, id])
  @@map("live_changes")
}

// --- Android application ---

/// One release of the mobile application, put up by an administrator.
///
/// The APK itself lies on disk, in the directory set by APP_DIR, under a name
/// made from its hash - the same idea as with attachments, so the database
/// does not swell up with tens of megabytes. Exactly one release is `current`:
/// that is the one the download page hands out and the one the application
/// compares itself against.
model AppRelease {
  id          String   @id @default(cuid())
  /// Version as people see it, for example 1.4.2.
  version     String
  /// versionCode from the APK. A plain number, because that is what the
  /// application compares to know whether it is behind.
  versionCode Int
  /// What changed in this version. Shown on the download page.
  notes       String?  @db.Text
  /// Name the file gets when downloaded, for example kajet-1.4.2.apk.
  fileName    String
  /// Hash of the file, and at the same time its name on disk: <hash>.apk.
  hash        String   @db.VarChar(64)
  sizeBytes   Int
  /// The version handed out now. Only one release has this set.
  current     Boolean  @default(false)
  /// How many times the file has been downloaded.
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())

  /// Empty once the account of the administrator who put it up is gone.
  uploadedById String?
  uploadedBy   User?   @relation("UploadedReleases", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([versionCode])
  @@index([current])
  @@index([createdAt])
  @@map("app_releases")
}

// --- Administrator audit log ---

/// Record of administrator actions. Needed so it is possible to check who
/// changed whose quota or who blocked whom.
model AuditEntry {
  id        BigInt   @id @default(autoincrement())
  actorId   String?
  action    String
  details   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_log")
}

// --- Awarie aplikacji na Androida ---

/// Raport o awarii przysłany przez aplikację.
///
/// Bez konta i bez tokenu: awaria trafia się także przed zalogowaniem, a
/// wtedy najbardziej trzeba wiedzieć, co się stało. Aplikacja wysyła to sama
/// przy najbliższym uruchomieniu, gdy jest sieć.
model CrashReport {
  id          BigInt   @id @default(autoincrement())
  /// versionName z aplikacji, na przykład 1.0.
  appVersion  String?  @db.VarChar(40)
  /// versionCode z pliku .apk. Liczba, więc od razu widać, która wersja.
  versionCode Int?
  /// Producent i model, na przykład LENOVO TB520FU.
  device      String?  @db.VarChar(120)
  /// Wersja Androida.
  android     String?  @db.VarChar(40)
  /// Wątek, na którym poleciał wyjątek.
  thread      String?  @db.VarChar(80)
  /// Pierwsza linia wyjątku razem ze szczytem stosu. Ta sama awaria zgłoszona
  /// wiele razy ma ten sam odcisk, więc powtórki dają się policzyć.
  fingerprint String   @db.VarChar(200)
  /// Cały raport, dokładnie taki, jaki widać na ekranie po awarii.
  report      String   @db.Text
  /// Adres, z którego przyszedł raport. Do wypatrzenia nadużyć - punkt jest
  /// otwarty dla każdego.
  fromAddress String?  @db.VarChar(60)
  /// Wypełnione tylko wtedy, gdy przy raporcie akurat był ważny token.
  /// Puste nie znaczy nic złego: wysyłka nie wymaga zalogowania.
  userId      String?
  /// Odhaczone w panelu administratora.
  seen        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([fingerprint])
  @@map("crash_reports")
}

// --- Asystent KajetAI ---

/// Jedna wymiana zdań z asystentem przy jednej notatce.
///
/// Historia jest po to, żeby „a teraz skróć to jeszcze bardziej" miało do
/// czego się odnieść. Trzyma się jej przy PARZE (konto, notatka), bo dwie
/// osoby pracujące nad tą samą udostępnioną notatką prowadzą dwie osobne
/// rozmowy, a ta sama osoba przy dwóch notatkach - też.
///
/// Wiersze tylko przybywają, nigdy się ich nie nadpisuje: obcięcie do
/// ostatnich kilku wymian robi się przy czytaniu, a stare znikają razem ze
/// sprzątaniem. Treści notatki tu nie ma - jest polecenie człowieka i zdanie,
/// którym asystent odpowiedział.
model AiTurn {
  id        BigInt   @id @default(autoincrement())
  userId    String
  noteId    String
  /// Polecenie, które napisał człowiek.
  request   String   @db.Text
  /// Odpowiedź asystenta: co zmienił albo o co dopytuje.
  reply     String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  /// Czytanie historii jednej rozmowy, od najnowszej.
  @@index([userId, noteId, id])
  /// Sprzątanie tego, co się przeterminowało.
  @@index([createdAt])
  @@map("ai_turns")
}

/// Zapis jednego wywołania modelu, do rozliczeń i do limitów.
///
/// Bez treści notatki, bez polecenia i bez identyfikatora notatki. Ma tu być
/// widać, ILE i ZA ILE, a nie co kto pisze - od rozmowy jest AiTurn, którą
/// człowiek może wyczyścić, a tego wiersza już nie.
model AiCall {
  id           BigInt   @id @default(autoincrement())
  userId       String
  /// Typ notatki: TEXT, MINDMAP albo CODE.
  kind         String   @db.VarChar(20)
  /// Nazwa modelu, na przykład gemini-3.6-flash. Ceny różnią się między
  /// modelami, więc bez tego rachunku nie da się złożyć.
  model        String   @db.VarChar(60)
  inputTokens  Int      @default(0)
  /// Razem z tokenami myślenia - Google liczy je do wyjścia.
  outputTokens Int      @default(0)
  tookMs       Int      @default(0)
  /// Puste, gdy się udało. Inaczej krótki powód: timeout, refused, invalid.
  failure      String?  @db.VarChar(40)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Liczenie limitu godzinowego i dobowego, i zużycie w panelu.
  @@index([userId, createdAt])
  @@map("ai_calls")
}

// --- Zapory ---

/// Licznik prób dla zapór: logowania, raportów o awariach, pytania o wersję
/// aplikacji, sprawdzania captchy i uruchamiania kodu.
///
/// Liczniki siedziały kiedyś w pamięci procesu. Restart je zerował, więc
/// kwadrans przerwy po pięciu błędnych hasłach kończył się przy najbliższym
/// wdrożeniu, a gdyby serwer chodził kiedyś w dwóch procesach, każdy liczyłby
/// po swojemu i wszystkie granice byłyby podwójne.
///
/// Wiersze są jednorazowe i nic po nich nie zostaje: sprząta je sweeper
/// z lib/rate-limit.ts, a skasowanie któregokolwiek najwyżej daruje komuś
/// przerwę.
model RateLimit {
  /// Co jest liczone: rodzaj zapory i to, czego dotyczy - na przykład
  /// „logowanie:mail:kto@example.com" albo „awarie:203.0.113.7". Adres
  /// e-mail bywa długi, a klucz główny przy utf8mb4 mieści 191 znaków,
  /// więc klucze dłuższe niż to skraca się z doklejonym odciskiem.
  bucket    String   @id @db.VarChar(190)
  /// Ile prób doliczono w tym oknie.
  hits      Int      @default(0)
  /// Początek okna. Wszystko starsze niż okno zaczyna liczenie od nowa.
  startedAt DateTime @default(now())

  /// Sprzątanie przeterminowanych.
  @@index([startedAt])
  @@map("rate_limits")
}
